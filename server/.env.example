# ==============================================================================
# NilePixel Offline Field Issue Tracker — Backend Environment Configuration
# ==============================================================================

# Server Environment & Port
NODE_ENV=development
PORT=3001

# Database Connections
# Local development & tests default to SQLite:
DATABASE_URL="file:./dev.db"
DIRECT_URL="file:./dev.db"

# Hosted Supabase PostgreSQL Configuration (for production deployment):
# DATABASE_URL="postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
# DIRECT_URL="postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require"

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed origins or '*' for unrestricted local dev:
CORS_ORIGIN="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000   # 15 minutes in milliseconds
RATE_LIMIT_MAX=300            # Max 300 requests per IP per window

