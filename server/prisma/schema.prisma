datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Report {
  id               String       @id
  reportNumber     String       @unique
  title            String
  description      String?
  category         String
  priority         String
  status           String
  syncStatus       String       @default("synced")
  latitude         Float?
  longitude        Float?
  locationName     String?
  locationAccuracy Float?
  reporterName     String?
  reporterId       String?
  assignedTo       String?
  assignedTeam     String?
  resolutionNotes  String?
  resolvedBy       String?
  resolvedAt       DateTime?
  version          Int          @default(1)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  activityLogs     ActivityLog[]
}

model ActivityLog {
  id            String   @id
  reportId      String?
  report        Report?  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  action        String
  actorName     String?
  description   String?
  previousValue String?
  newValue      String?
  createdAt     DateTime @default(now())
}

model IdempotencyRecord {
  key       String   @id
  response  String
  createdAt DateTime @default(now())
}

